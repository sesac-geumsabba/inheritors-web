DATABASE_URL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=hf.co/gchrisoh/EEVE-Korean-Instruct-10.8B-v1.0-Q4_K_M-GGUF
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# bge-m3(packages/rag/embeddings.py) 다운로드용. huggingface_hub가 os.environ에서 자동으로
# 읽어가서 코드 수정 불필요 — 없어도 동작은 하지만 "unauthenticated requests" 경고가 뜨고
# rate limit이 낮음. huggingface.co/settings/tokens 에서 발급 (read 권한이면 충분).
HF_TOKEN=
MCP_AGENT_MODEL=gpt-4o-mini
LAW_OC=inheritors
KOREAN_LAW_MCP_SCRIPT_PATH=
# 판례 검색 폴백(lexguard-mcp, apps/api/app/lexguard_client.py). korean-law-mcp가 0건일
# 때만 보조로 호출됨 — LAW_API_KEY는 open.law.go.kr에서 별도 발급(IP/도메인 등록 필요),
# LEXGUARD_MCP_URL은 로컬 dev 기준(docker-compose로 띄우면 http://lexguard-mcp:9099/mcp로 덮어씀).
LAW_API_KEY=
LEXGUARD_MCP_URL=http://localhost:9099/mcp
